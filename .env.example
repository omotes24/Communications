# 文字起こし・リアルタイム音声・Web検索付き企業調査のプロバイダ
AI_PROVIDER=openai
# テキスト生成（回答・分類・GD・学習メモなど）のプロバイダ。未設定なら AI_PROVIDER と同じ
# mercury にすると Inception Labs の拡散型LLM Mercury 3 を Vercel AI Gateway 経由で使う
AI_TEXT_PROVIDER=
# Vercel ダッシュボードの AI Gateway → API Keys で作るキー（vck_...）
MERCURY_API_KEY=
MERCURY_BASE_URL=https://ai-gateway.vercel.sh/v1
# 分類・通常回答・GD発言（速度優先）。Gateway では none が最速（instant は none に読み替える）
MERCURY_FAST_MODEL=inception/mercury-3
MERCURY_FAST_REASONING_EFFORT=none
# 学習メモ・GDテーマ/評価・フェルミ推定（精度優先）
MERCURY_MODEL=inception/mercury-3
MERCURY_REASONING_EFFORT=medium
# 面接中のフェルミ推定の推論の強さ（medium だと約21秒かかるため low）
MERCURY_FERMI_REASONING_EFFORT=low
# 面接前メモの学習の推論の強さ（low で約3秒。medium は推論が膨らみ遅くなる）
MERCURY_LEARNING_REASONING_EFFORT=low
# Mercury API は 2026-12-28 で終了するため、この日時を過ぎたら自動で AI_PROVIDER に戻す
MERCURY_DISABLE_AFTER=2026-12-28T00:00:00+09:00
NEXT_PUBLIC_APP_NAME=Yell for You 1.3
NEXT_PUBLIC_SITE_URL=
OPENAI_API_KEY=

OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_TRANSCRIPTION_DELAY=high
OPENAI_AUDIO_NOISE_REDUCTION=far_field
OPENAI_CLASSIFIER_MODEL=gpt-5.4-nano
OPENAI_ANSWER_MODEL=gpt-5.6-luna
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_COMPANY_RESEARCH_MODEL=gpt-5.6-sol
OPENAI_INTERVIEW_LEARNING_MODEL=gpt-5.6-sol
OPENAI_QUESTION_SOLVER_MODEL=gpt-5.6-terra
OPENAI_GROUP_DISCUSSION_MODEL=gpt-5.6-terra
OPENAI_GD_MOCK_MODE=false
COMPANY_INTELLIGENCE_STRICT_MODE=true
COMPANY_INTELLIGENCE_MOCK_MODE=false
COMPANY_INTELLIGENCE_DEEP_RESEARCH_MODEL=gpt-5.6-terra
COMPANY_INTELLIGENCE_SYNTHESIS_MODEL=gpt-5.6-terra

AI_MOCK_MODE=false

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKETS=

APP_SIGNUP_GRANT_TOKENS=0
APP_REALTIME_SESSION_RESERVATION_SECONDS=180
CRON_SECRET=

# 管理ダッシュボード(/admin)の単一オーナー Supabase Auth user UUID。
# 値は必ず1件だけ。メールアドレスとの二重一致で認可する。
ADMIN_USER_IDS=
ADMIN_AUDIT_HMAC_SECRET=
OPENAI_USD_JPY_RATE=150
OPENAI_WEB_SEARCH_USD_PER_CALL=0.01
# trueで匿名Webアクセス収集を開始（公開プライバシー画面・90日保持・オプトアウト対応）
NEXT_PUBLIC_PRODUCT_ANALYTICS_ENABLED=false
# 将来機能。通常ユーザーへ公開するまでは false のままにする
INTERVIEW_EXPERIENCE_ENABLED=false

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
HELP_CONTACT_FROM_EMAIL=
HELP_CONTACT_TO_EMAIL=
